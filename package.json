{
  "name": "novel-branches",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "みんなで小説を作ろう — 分岐する小説と閲覧用MCP",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "user": "node scripts/user.mjs",
    "demo": "node scripts/demo.mjs",
    "mcp": "node src/stdio.mjs",
    "test:stack": "node scripts/test-stack.mjs",
    "local": "node scripts/local-stack.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:expiry": "node scripts/test-expiry.mjs"
  },
  "dependencies": {
    "jose": "6.2.13",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
