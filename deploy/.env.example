PUBLIC_HOST=novels.example.com
APP_ORIGIN=https://novels.example.com
TLS_DIR=/absolute/path/to/tls-directory
# Directory must contain fullchain.pem and privkey.pem.
# Set each secret to an independent random value of at least 32 characters.
OIDC_CLIENT_SECRET=
KC_DB_PASSWORD=
KC_ADMIN_PASSWORD=
KC_ADMIN_USER=admin
# Only Nginx publishes ports. Defaults: 0.0.0.0:80 and 0.0.0.0:443.
HTTP_PORT=80
HTTPS_PORT=443
# Keycloak container memory ceiling protects the host from JVM native-memory growth.
# A small VPS should use >=2GiB RAM or provision swap, and size the heap below this ceiling.
KC_MEMORY_LIMIT=768m
KC_HEAP=-Xms64m -Xmx256m
# Optional application mount path. APP_ORIGIN remains scheme + host (+ port).
APP_BASE_PATH=
